PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Public base URL used to build shareable links, e.g. https://myshop.example.com
APP_BASE_URL=http://localhost:3000
# Seconds the customer waits before retrying an unclear verification (default 60)
VERIFY_RETRY_WAIT_SECS=60
# Request limits: max attempts per IP per window (defaults: signup/login 10/600s, initiate 20/600s, verify 30/600s)
RATE_SIGNUP_LIMIT=10
RATE_SIGNUP_WINDOW_SECS=600
RATE_LOGIN_LIMIT=10
RATE_LOGIN_WINDOW_SECS=600
# Max login tries per email per window (default 10/600s), on top of the per-IP limit
RATE_LOGIN_PER_EMAIL_LIMIT=10
RATE_INITIATE_LIMIT=20
RATE_INITIATE_WINDOW_SECS=600
RATE_VERIFY_LIMIT=30
RATE_VERIFY_WINDOW_SECS=600
# Only trust X-Forwarded-For for rate limiting when behind your own proxy (default false)
TRUST_PROXY=false
